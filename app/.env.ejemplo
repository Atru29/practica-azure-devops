# =====================================================================
#  Plantilla de configuracion. Copiala a .env y pon tus valores.
#
#    cp .env.ejemplo .env
#
#  .env NO se sube al repositorio: esta en .gitignore.
# =====================================================================

# Contrasena de 'sa' en el SQL Server local.
# Requisitos: 8 caracteres minimo y 3 de estos 4 tipos:
# mayuscula, minuscula, digito, simbolo.
SQL_PASSWORD=CambiaEstaClave#2026

# Cadena de conexion que usara la API.
# LOCAL  -> apunta al contenedor
# Las comillas son OBLIGATORIAS: sin ellas, el shell interpreta los ";"
# como separadores de comandos al cargar este fichero.
CADENA_CONEXION="Server=localhost,1435;Database=appdb;User Id=sa;Password=CambiaEstaClave#2026;TrustServerCertificate=true;Encrypt=true"

# PRODUCCION -> Azure SQL. No va aqui: va en el .env de la maquina.
# CADENA_CONEXION="Server=sqlsrv-demo01-us.database.windows.net,1433;Database=appdb;User Id=sqladmin;Password=...;Encrypt=true"

# Clave de firma de los tokens (minimo 32 caracteres).
JWT_CLAVE=cambia-esta-clave-de-firma-por-una-larga-y-aleatoria

# =====================================================================
#  Plantilla de las variables de produccion.
#
#  En la maquina se copia a .env.prod, se rellena y se protege:
#      chmod 600 .env.prod
#
#  NUNCA se versiona el fichero relleno.
# =====================================================================

# Registro de contenedores, sin https://
REGISTRO=acrdemo01prod.azurecr.io

# Etiqueta de las imagenes. 'latest' sirve para empezar, pero conviene
# usar el hash del commit: asi sabes exactamente que version corre.
ETIQUETA=latest

# Azure SQL. El usuario NO es el administrador del servidor: es el
# usuario de aplicacion de 05-usuario-aplicacion.sql, que solo puede
# ejecutar procedimientos.
SQL_CONEXION=Server=tcp:SERVIDOR.database.windows.net,1433;Database=appdb;User Id=app_matriculas;Password=CAMBIAME;Encrypt=true;TrustServerCertificate=false;Connection Timeout=60

# Firma de los tokens. Si cambia, todas las sesiones abiertas se caen.
# Generar con: openssl rand -base64 48
JWT_CLAVE=CAMBIAME

# Cuenta de almacenamiento real
ALMACEN_CONEXION=DefaultEndpointsProtocol=https;AccountName=CUENTA;AccountKey=CAMBIAME;EndpointSuffix=core.windows.net
